# React development server port.
# Must not conflict with the legacy backend (3000) or Nest (3002).
PORT=3001

# Leave unset to use the local legacy API at http://localhost:3000 (development default).
# Set to http://localhost:3002 to validate the frontend against NestJS locally.
# Copy this file to .env.local and uncomment the line below — do not commit .env.local.
# REACT_APP_API_BASE_URL=http://localhost:3002
